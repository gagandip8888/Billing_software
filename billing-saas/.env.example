# Database (Supabase PostgreSQL Connection Strings)
# Transaction pooled connection URL for runtime Prisma queries
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct connection URL for Prisma schema migrations (bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# NextAuth / Auth.js Authentication
# Generate a secret using: npx auth secret OR openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-32-chars-minimum"
AUTH_SECRET="your-nextauth-secret-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments Gateway (Razorpay India)
# Get keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Notifications (WhatsApp Cloud API)
WHATSAPP_API_TOKEN="your_whatsapp_cloud_api_token"
